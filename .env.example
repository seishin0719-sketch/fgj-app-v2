# ===== 基本 =====
NODE_ENV=development          # 正式環境改 production
PORT=3000
# 位於 Nginx/Caddy/雲端負載平衡後方時設為 1，才能正確判斷 HTTPS 與來源 IP
TRUST_PROXY=0
# 正式環境（HTTPS）務必為 true；本機 http 測試可 false
COOKIE_SECURE=false
# 資料庫檔案位置
DB_FILE=./data/fgj.sqlite

# ===== 管理員（首次啟動時建立，之後可移除此兩行）=====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=請改成至少12碼的強密碼

# ===== AI（Gemini）=====
# 留空 = 測試模式（回覆模擬文字，不呼叫外部 API）
# 請先撤銷舊版外洩的金鑰，再到 Google AI Studio 重新產生，只放在伺服器環境變數
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash   # 沿用原版設定的模型名稱，可依 Google 現行型號調整

# ===== 價格 =====
PRICES_FILE=./config/prices.json

# ===== 金流 =====
# mock = 模擬金流（僅非 production 可用）；ecpay / newebpay 尚未實作
PAYMENT_PROVIDER=mock
# 用於驗證金流通知（webhook）簽章，請設定長隨機字串
PAYMENT_WEBHOOK_SECRET=請改成長隨機字串
# 對外網址（金流回呼用），例如 https://app.你的網域.tw
PUBLIC_BASE_URL=http://localhost:3000
